// Place your settings in this file to overwrite default and user settings.
{
  "eslint.enable": true,
  "files.exclude": {
    "**/dist": false,
    "docs": true,
    "packages": false,
  },
  "files.watcherExclude": {
    "**/dist": true,
    "docs": true,
    "packages": false,
  },
  "search.exclude": {
    "**/dist": true,
    "docs": true,
    "packages": false,
  },
  "sqltools.connections": [
    {
      "name": "Heimdall",
      "target": "kyuubi",
      "authMode": "cookie-file",
      "previewLimit": 50,
      "driver": "Heimdall",
      "group": "Heimdall"
    },
    {
      "name": "Heimdall-eks",
      "target": "spark-eks",
      "authMode": "cookie-file",
      "previewLimit": 50,
      "driver": "Heimdall",
      "group": "heimdall-eks"
    }
  ]
}